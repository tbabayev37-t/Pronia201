@model Shipping     
<div class="container">
    <div class="row">
        <form method="post" asp-controller="Shipping" asp-action="Create" enctype="multipart/form-data">
            <div class="form-group">
                <label for="exampleInputEmail1">ImageUrl</label>
                <input  class="form-control" id="exampleInputEmail1" asp-for="Image" placeholder="Enter shipping imageUrl">
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="exampleInputEmail1">Title</label>
                <input  class="form-control" id="exampleInputEmail1" asp-for="Title" placeholder="Enter shipping title">
                <span asp-validation-for="Title" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label for="exampleInputEmail1">Description</label>
                <input  class="form-control" id="exampleInputEmail1" asp-for="Description" placeholder="Enter shipping description">
                <span asp-validation-for="Description" class="text-danger"></span>

            </div>


            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>
