@model ProductGetVM
<div class="card" style="width: 18rem;">
    <img class="card-img-top" src="~/assets/images/website-images/@Model.MainImage" alt="Card image cap">
    <img class="card-img-top" src="~/assets/images/website-images/@Model.HoverImage" alt="Card image cap">
    <div class="card-body">
        <p class="card-text">Name: @Model.Name</p>
        <p class="card-text">Description: @Model.Description</p>
        <p class="card-text">Category: @Model.CategoryName</p>
        <p class="card-text">SKU: @Model.SKU</p>
        <p class="card-text">Price: @Model.Price</p>
        <p class="card-text">Tags: @foreach (var tagname in Model.TagNames)
            {
                <span>@tagname,</span>
            }</p>
        <h5>Gallery</h5>

        <div class="d-flex flex-wrap gap-2">
            @foreach (var img in Model.ImageUrls)
            {
                <img src="~/assets/images/website-images/@img"
                     width="120"
                     style="border:1px solid #ccc; padding:5px;" />
            }
        </div>

    </div>
</div>